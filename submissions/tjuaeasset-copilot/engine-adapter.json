{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/engine-adapter-definition.v1.schema.json",
  "schemaVersion": 1,
  "kind": "engineAdapter",
  "id": "copilot",
  "runtimeId": "copilot",
  "displayName": "GitHub Copilot",
  "description": "通过 ACP 接入 GitHub Copilot 的候选引擎适配器。",
  "icon": "resources/icon.svg",
  "protocol": {
    "type": "acp",
    "transport": "stdio",
    "arguments": ["--acp"]
  },
  "runtime": {
    "commandName": "copilot"
  },
  "capabilities": {
    "streaming": false,
    "authenticationRequired": true
  }
}
