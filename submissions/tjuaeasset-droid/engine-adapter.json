{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/engine-adapter-definition.v1.schema.json",
  "schemaVersion": 1,
  "kind": "engineAdapter",
  "id": "droid",
  "runtimeId": "droid",
  "displayName": "Droid",
  "description": "通过 ACP 接入 Factory Droid 的候选引擎适配器。",
  "icon": "resources/icon.svg",
  "protocol": {
    "type": "acp",
    "transport": "stdio",
    "arguments": ["exec", "--output-format", "acp"]
  },
  "runtime": {
    "commandName": "droid"
  },
  "capabilities": {
    "streaming": false,
    "authenticationRequired": true
  }
}
