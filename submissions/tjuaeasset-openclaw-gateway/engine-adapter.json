{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/engine-adapter-definition.v1.schema.json",
  "schemaVersion": 1,
  "kind": "engineAdapter",
  "id": "openclaw-gateway",
  "runtimeId": "openclaw-gateway",
  "displayName": "OpenClaw",
  "description": "通过 ACP 接入 OpenClaw 的候选引擎适配器。",
  "icon": "resources/icon.svg",
  "protocol": {
    "type": "acp",
    "transport": "stdio",
    "arguments": ["acp"]
  },
  "runtime": {
    "commandName": "openclaw"
  },
  "capabilities": {
    "streaming": true,
    "authenticationRequired": false
  }
}
