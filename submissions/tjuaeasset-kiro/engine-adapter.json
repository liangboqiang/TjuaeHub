{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/engine-adapter-definition.v1.schema.json",
  "schemaVersion": 1,
  "kind": "engineAdapter",
  "id": "kiro",
  "runtimeId": "kiro",
  "displayName": "Kiro CLI",
  "description": "通过 ACP 接入 AWS Kiro CLI 的候选引擎适配器。",
  "protocol": {
    "type": "acp",
    "transport": "stdio",
    "arguments": ["acp"]
  },
  "runtime": {
    "commandName": "kiro-cli"
  },
  "capabilities": {
    "streaming": false,
    "authenticationRequired": true
  }
}
