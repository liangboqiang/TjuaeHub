{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "openclaw-gateway",
        "name": "OpenClaw",
        "icon": "resources/icon.svg",
        "description": "OpenClaw 适配器",
        "connectionType": "stdio",
        "cliCommand": "openclaw",
        "defaultCliPath": "bunx openclaw",
        "authRequired": false,
        "supportsStreaming": true,
        "acpArgs": ["acp"]
      }
    ]
  },
  "description": "将 OpenClaw 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "OpenClaw",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["add", "-g", "openclaw"]
      },
      "timeout": 30000
    }
  },
  "name": "tjuaeext-openclaw-gateway",
  "version": "1.0.0"
}
