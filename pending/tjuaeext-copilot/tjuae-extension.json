{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "copilot",
        "name": "GitHub Copilot",
        "icon": "resources/icon.svg",
        "description": "GitHub Copilot 适配器",
        "connectionType": "stdio",
        "cliCommand": "copilot",
        "defaultCliPath": "bunx @github/copilot",
        "acpArgs": ["--acp"],
        "authRequired": true,
        "supportsStreaming": false
      }
    ]
  },
  "description": "将 GitHub Copilot 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "GitHub Copilot",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["install", "-g", "@github/copilot"]
      },
      "timeout": 60000
    }
  },
  "name": "tjuaeext-copilot",
  "version": "1.0.0"
}
