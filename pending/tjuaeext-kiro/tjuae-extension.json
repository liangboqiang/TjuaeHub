{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "kiro",
        "name": "Kiro CLI",
        "description": "Kiro CLI 适配器（AWS）",
        "connectionType": "stdio",
        "cliCommand": "kiro-cli",
        "authRequired": true,
        "supportsStreaming": false,
        "acpArgs": ["acp"]
      }
    ]
  },
  "description": "将 Kiro CLI 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "Kiro CLI",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 120000
    }
  },
  "name": "tjuaeext-kiro",
  "version": "1.0.0"
}
