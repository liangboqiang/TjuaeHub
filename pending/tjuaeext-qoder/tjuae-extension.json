{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "qoder",
        "name": "Qoder CLI",
        "icon": "resources/icon.png",
        "description": "Qoder CLI 适配器",
        "connectionType": "stdio",
        "cliCommand": "qodercli",
        "defaultCliPath": "bunx @qoder-ai/qodercli",
        "authRequired": true,
        "supportsStreaming": false,
        "acpArgs": ["--acp"]
      }
    ]
  },
  "description": "将 Qoder CLI 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "Qoder CLI",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["add", "-g", "--trust", "@qoder-ai/qodercli"]
      },
      "timeout": 60000
    }
  },
  "name": "tjuaeext-qoder",
  "version": "1.0.0"
}
