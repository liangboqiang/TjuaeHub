{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "claude",
        "name": "Claude Code",
        "icon": "resources/icon.svg",
        "description": "通过 ACP 接入的 Claude Code 适配器",
        "cliCommand": "claude",
        "defaultCliPath": "bunx @agentclientprotocol/claude-agent-acp",
        "acpArgs": [],
        "skillsDirs": [".claude/skills"]
      }
    ]
  },
  "description": "将 Anthropic Claude Code CLI 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "Claude Code",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 120000
    }
  },
  "name": "tjuaeext-claude",
  "version": "1.0.0"
}
