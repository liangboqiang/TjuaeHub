{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "qwen",
        "name": "Qwen Code",
        "icon": "resources/icon.svg",
        "description": "Qwen Code 适配器",
        "cliCommand": "qwen",
        "defaultCliPath": "bunx @qwen-code/qwen-code",
        "acpArgs": ["--acp"],
        "skillsDirs": [".qwen/skills"]
      }
    ]
  },
  "description": "将 Qwen CLI 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "Qwen Code",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 30000
    }
  },
  "name": "tjuaeext-qwen",
  "version": "1.0.0"
}
