{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "TjuaeUI",
  "contributes": {
    "acpAdapters": [
      {
        "id": "codex",
        "name": "Codex",
        "icon": "resources/icon.svg",
        "description": "OpenAI Codex adapter (via ACP adapter)",
        "cliCommand": "codex",
        "defaultCliPath": "bunx @zed-industries/codex-acp",
        "acpArgs": [],
        "skillsDirs": [".codex/skills"]
      }
    ]
  },
  "description": "Integrates OpenAI Codex CLI as an ACP adapter in TjuaeUI.",
  "displayName": "Codex",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 120000
    }
  },
  "name": "tjuaeext-codex",
  "version": "1.0.0"
}
