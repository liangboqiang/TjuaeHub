{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "codex",
        "name": "Codex",
        "icon": "resources/icon.svg",
        "description": "通过 ACP 接入的 OpenAI Codex 适配器",
        "cliCommand": "codex",
        "defaultCliPath": "bunx @zed-industries/codex-acp",
        "acpArgs": [],
        "skillsDirs": [".codex/skills"]
      }
    ]
  },
  "description": "将 OpenAI Codex CLI 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "Codex",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 120000
    }
  },
  "name": "tjuaeext-codex",
  "version": "1.0.0"
}
