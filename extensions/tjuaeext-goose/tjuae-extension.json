{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "goose",
        "name": "Goose",
        "icon": "resources/icon.svg",
        "description": "Goose 适配器",
        "cliCommand": "goose",
        "acpArgs": ["acp"],
        "skillsDirs": [".goose/skills"]
      }
    ]
  },
  "description": "将 Goose 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "Goose",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 120000
    }
  },
  "name": "tjuaeext-goose",
  "version": "1.0.0"
}
