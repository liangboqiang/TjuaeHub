{
    "$schema": "https://raw.githubusercontent.com/iOfficeAI/AionHub/spec/v0/extension-manifest.schema.json",
    "author": "Aionui Official",
    "contributes": {
        "acpAdapters": [
            {
                "id": "claude",
                "name": "Claude Code",
                "description": "Official Claude Code adapter (via ACP adapter)",
                "cliCommand": "claude",
                "defaultCliPath": "bunx @agentclientprotocol/claude-agent-acp",
                "acpArgs": [],
                "installedBinaryPath": "node_modules/.bin/claude-agent-acp",
                "skillsDirs": [".claude/skills"]
            }
        ]
    },
    "description": "Integrates Anthropic's Claude Code CLI as an ACP adapter in AionUi.",
    "displayName": "Claude Code",
    "engine": {
        "aionui": "^1.0.0"
    },
    "lifecycle": {
        "onInstall": {
            "shell": {
                "cliCommand": "bun",
                "args": ["run", "scripts/install.ts"]
            },
            "timeout": 120000
        }
    },
    "name": "aionext-claude",
    "version": "1.0.0"
}
