{
  "$schema": "https://raw.githubusercontent.com/iOfficeAI/AionHub/spec/v0/extension-manifest.schema.json",
  "author": "Aionui Official",
  "contributes": {
    "acpAdapters": [
      {
        "id": "auggie",
        "name": "Augment Code",
        "icon": "resources/icon.svg",
        "description": "Official Augment Code adapter",
        "cliCommand": "auggie",
        "defaultCliPath": "bunx @augmentcode/auggie",
        "acpArgs": ["--acp"],
        "installedBinaryPath": "node_modules/.bin/auggie"
      }
    ]
  },
  "description": "Integrates Augment Code as an ACP adapter in AionUi.",
  "displayName": "Augment Code",
  "engine": {
    "aionui": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 30000
    }
  },
  "name": "aionext-auggie",
  "version": "1.0.0"
}
