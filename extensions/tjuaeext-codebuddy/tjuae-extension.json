{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "author": "Tjuae",
  "contributes": {
    "acpAdapters": [
      {
        "id": "codebuddy",
        "name": "CodeBuddy",
        "icon": "resources/icon.svg",
        "description": "CodeBuddy 适配器",
        "cliCommand": "codebuddy",
        "defaultCliPath": "bunx @tencent-ai/codebuddy-code",
        "acpArgs": ["--acp"],
        "skillsDirs": [".codebuddy/skills"]
      }
    ]
  },
  "description": "将 CodeBuddy 作为 ACP 适配器集成到 TjuaeUI。",
  "displayName": "CodeBuddy",
  "engine": {
    "tjuae": "^1.0.0"
  },
  "lifecycle": {
    "onInstall": {
      "shell": {
        "cliCommand": "bun",
        "args": ["run", "scripts/install.ts"]
      },
      "timeout": 30000
    }
  },
  "name": "tjuaeext-codebuddy",
  "version": "1.0.0"
}
