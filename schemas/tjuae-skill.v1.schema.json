{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/tjuae-skill.v1.schema.json",
  "version": "1.0.0",
  "title": "Tjuae 公共技能包清单 v1",
  "description": "仅描述可移植技能本身。用户偏好、来源、本地路径、Git 与缓存状态不属于技能包协议。",
  "type": "object",
  "required": [
    "$schema",
    "format",
    "formatVersion",
    "id",
    "version",
    "categories",
    "compatibility",
    "requirements",
    "contentHash",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/tjuae-skill.v1.schema.json"
    },
    "format": { "const": "agent-skill" },
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/Slug" },
    "version": { "$ref": "#/$defs/Semver" },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "compatibility": { "type": "object" },
    "requirements": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "contentHash": { "$ref": "#/$defs/Digest" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "Slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "Digest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" }
  }
}
