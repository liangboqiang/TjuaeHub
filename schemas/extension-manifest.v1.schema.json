{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/extension-manifest.v1.schema.json",
  "version": "1.0.0",
  "title": "TjuaeUI 扩展清单",
  "description": "TjuaeUI 扩展清单模式。注意：Zod .refine() 验证（例如重复 ID 检查和条件必填字段）无法用 JSON Schema 表达，只能在运行时执行。",
  "type": "object",
  "required": ["name", "displayName", "version", "contributes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 2,
      "maxLength": 64,
      "description": "扩展名称使用 kebab-case，不得以保留前缀 tjuae-、internal-、builtin- 或 system- 开头"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$",
      "description": "语义化版本格式（例如 1.0.0）"
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "icon": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "apiVersion": {
      "type": "string",
      "pattern": "^\\^?\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$",
      "description": "扩展 API 兼容版本范围（例如 ^1.0.0）"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\^?\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$"
      },
      "description": "扩展依赖：{ extensionName: versionRange }"
    },
    "engine": {
      "type": "object",
      "properties": {
        "tjuae": {
          "type": "string",
          "pattern": "^\\^?\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$",
          "description": "兼容的 TjuaeUI 核心版本范围"
        }
      },
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "properties": {
        "localesDir": { "type": "string", "default": "i18n" },
        "defaultLocale": { "type": "string", "default": "zh-CN" }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "onInstall": { "$ref": "#/$defs/LifecycleHook" },
        "onActivate": { "$ref": "#/$defs/LifecycleHook" },
        "onDeactivate": { "$ref": "#/$defs/LifecycleHook" },
        "onUninstall": { "$ref": "#/$defs/LifecycleHook" }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "storage": { "type": "boolean", "default": false },
        "network": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "required": ["allowedDomains"],
              "properties": {
                "allowedDomains": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "reasoning": { "type": "string" }
              },
              "additionalProperties": false
            }
          ],
          "default": false
        },
        "shell": { "type": "boolean", "default": false },
        "filesystem": {
          "type": "string",
          "enum": ["extension-only", "workspace", "full"],
          "default": "extension-only"
        },
        "clipboard": { "type": "boolean", "default": false },
        "activeUser": { "type": "boolean", "default": false },
        "events": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "contributes": { "$ref": "#/$defs/Contributes" }
  },
  "$defs": {
    "ContributionFileReference": {
      "type": "string",
      "pattern": "^\\$file:(?!\\s)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*\\.json$",
      "description": "以 $file: 开头并使用正斜杠的相对 JSON 路径。不得包含前导空白、绝对路径、Windows 盘符或 UNC 路径、反斜杠、空路径段以及 '..' 路径穿越。"
    },
    "LifecycleHook": {
      "description": "生命周期钩子，可以是脚本路径字符串，也可以是包含 script/shell 的对象。运行时要求必须提供 'script' 或 'shell' 之一。",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "timeout": { "type": "integer", "exclusiveMinimum": 0 },
            "script": { "type": "string" },
            "shell": {
              "type": "object",
              "required": ["cliCommand"],
              "properties": {
                "cliCommand": { "type": "string" },
                "args": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Field": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["text", "password", "select", "number", "boolean"]
        },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string" } },
        "default": {
          "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
        }
      },
      "additionalProperties": false
    },
    "AcpAdapter": {
      "type": "object",
      "required": ["id", "name"],
      "description": "运行时要求：CLI/stdio 适配器必须提供 cliCommand 或 defaultCliPath；websocket/http 适配器必须提供 endpoint。",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "cliCommand": { "type": "string" },
        "defaultCliPath": { "type": "string" },
        "acpArgs": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "icon": { "type": "string" },
        "connectionType": {
          "type": "string",
          "enum": ["cli", "stdio", "websocket", "http"],
          "default": "cli"
        },
        "authRequired": {
          "type": "boolean",
          "default": false,
          "description": "适配器在使用前是否需要身份验证流程"
        },
        "supportsStreaming": {
          "type": "boolean",
          "default": true,
          "description": "适配器是否支持流式响应更新"
        },
        "endpoint": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "apiKeyFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/Field" },
          "description": "设置界面的 API 密钥字段。启动适配器时会将其值注入环境变量。"
        },
        "healthCheck": {
          "type": "object",
          "required": ["versionCommand"],
          "properties": {
            "versionCommand": { "type": "string" },
            "timeout": { "type": "number" }
          },
          "additionalProperties": false
        },
        "skillsDirs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "McpTransport": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "command"],
          "properties": {
            "type": { "const": "stdio" },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "sse" },
            "url": { "type": "string" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "http" },
            "url": { "type": "string" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "streamable_http" },
            "url": { "type": "string" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "McpServer": {
      "type": "object",
      "required": ["name", "transport"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "transport": { "$ref": "#/$defs/McpTransport" },
        "enabled": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "Assistant": {
      "type": "object",
      "required": ["id", "name", "presetAgentType", "contextFile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "avatar": { "type": "string" },
        "presetAgentType": {
          "type": "string",
          "minLength": 1,
          "description": "内置类型包括 gemini、claude、codex、codebuddy、opencode，也可使用扩展提供的任意适配器 ID"
        },
        "contextFile": { "type": "string", "minLength": 1 },
        "models": { "type": "array", "items": { "type": "string" } },
        "enabledSkills": { "type": "array", "items": { "type": "string" } },
        "prompts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "Skill": {
      "type": "object",
      "required": ["name", "file"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "file": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ChannelPlugin": {
      "type": "object",
      "required": ["type", "name", "entryPoint"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "entryPoint": { "type": "string", "minLength": 1 },
        "credentialFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/Field" }
        },
        "configFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/Field" }
        }
      },
      "additionalProperties": false
    },
    "ApiRoute": {
      "type": "object",
      "required": ["path", "entryPoint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "entryPoint": { "type": "string" },
        "description": { "type": "string" },
        "auth": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "WsHandler": {
      "type": "object",
      "required": ["namespace", "entryPoint"],
      "properties": {
        "namespace": { "type": "string" },
        "entryPoint": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Middleware": {
      "type": "object",
      "required": ["entryPoint"],
      "properties": {
        "entryPoint": { "type": "string" },
        "description": { "type": "string" },
        "applyTo": { "type": "string", "default": "/**" },
        "order": {
          "type": "string",
          "enum": ["before", "after"],
          "default": "before"
        }
      },
      "additionalProperties": false
    },
    "StaticAsset": {
      "type": "object",
      "required": ["urlPrefix", "directory"],
      "properties": {
        "urlPrefix": { "type": "string", "minLength": 1 },
        "directory": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Webui": {
      "type": "object",
      "properties": {
        "apiRoutes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApiRoute" }
        },
        "wsHandlers": {
          "type": "array",
          "items": { "$ref": "#/$defs/WsHandler" }
        },
        "middleware": {
          "type": "array",
          "items": { "$ref": "#/$defs/Middleware" }
        },
        "staticAssets": {
          "type": "array",
          "items": { "$ref": "#/$defs/StaticAsset" }
        }
      },
      "additionalProperties": false
    },
    "Theme": {
      "type": "object",
      "required": ["id", "name", "file"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "file": { "type": "string" },
        "cover": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ModelProvider": {
      "type": "object",
      "required": ["id", "platform", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "platform": {
          "type": "string",
          "minLength": 1,
          "description": "例如 custom、gemini、anthropic、new-api、bedrock"
        },
        "name": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "logo": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SettingsTab": {
      "type": "object",
      "required": ["id", "name", "entryPoint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "entryPoint": { "type": "string", "minLength": 1 },
        "position": {
          "type": "object",
          "required": ["anchor", "placement"],
          "properties": {
            "anchor": { "type": "string", "minLength": 1 },
            "placement": {
              "type": "string",
              "enum": ["before", "after"]
            }
          },
          "additionalProperties": false,
          "description": "可作为锚点的内置标签页 ID：gemini、model、agent、tools、display、webui、system、about"
        },
        "order": {
          "type": "number",
          "default": 100,
          "description": "多个标签页指向同一 anchor+placement 时使用的后备数字顺序，数值越小越靠前。"
        }
      },
      "additionalProperties": false
    },
    "Contributes": {
      "type": "object",
      "description": "每项贡献既可内联声明，也可通过 $file: 引用安全的相对 JSON 文件。运行时要求每个数组内的 ID 唯一，智能体 ID 不得与助手 ID 冲突。",
      "properties": {
        "acpAdapters": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/AcpAdapter" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "mcpServers": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/McpServer" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "assistants": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/Assistant" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "agents": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/Assistant" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ],
          "description": "智能体预设在结构上与助手相同，但语义上表示自主智能体"
        },
        "skills": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/Skill" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "channelPlugins": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/ChannelPlugin" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "webui": {
          "oneOf": [{ "$ref": "#/$defs/Webui" }, { "$ref": "#/$defs/ContributionFileReference" }]
        },
        "themes": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/Theme" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "settingsTabs": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/SettingsTab" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        },
        "modelProviders": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/ModelProvider" }
            },
            { "$ref": "#/$defs/ContributionFileReference" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
