{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/hub-index.v2.schema.json",
  "version": "2.0.0",
  "title": "TjuaeHub Index v2",
  "description": "TjuaeHub 唯一支持的远程市场索引。packages 是原子分发单元，assets 是 Core 可管理的资产单元；两者身份严格分离。",
  "type": "object",
  "required": ["$schema", "schemaVersion", "generatedAt", "assets", "packages", "metadata"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/hub-index.v2.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/AssetId" },
      "additionalProperties": { "$ref": "#/$defs/AssetEntry" }
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/PackageName" },
      "additionalProperties": { "$ref": "#/$defs/PackageEntry" }
    },
    "metadata": { "$ref": "#/$defs/IndexMetadata" }
  },
  "$defs": {
    "PackageName": {
      "type": "string",
      "pattern": "^tjuaeasset-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 12,
      "maxLength": 96
    },
    "AssetLocalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "AssetKind": {
      "type": "string",
      "enum": ["assistant", "engineAdapter", "skill", "mcp"]
    },
    "AssetId": {
      "type": "string",
      "pattern": "^tjuaeasset-[a-z0-9]+(?:-[a-z0-9]+)*/(?:assistant|engineAdapter|skill|mcp)/[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
      "maxLength": 256
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "Integrity": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "TjuaeVersionRange": {
      "type": "string",
      "pattern": "^\\^?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "SafeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "AssetFile": {
      "type": "object",
      "required": ["path", "digest", "size", "mediaType"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/SafeRelativePath" },
        "digest": { "$ref": "#/$defs/Integrity" },
        "size": { "type": "integer", "minimum": 0, "maximum": 52428800 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "Compatibility": {
      "type": "object",
      "required": ["tjuae"],
      "additionalProperties": false,
      "properties": {
        "tjuae": { "$ref": "#/$defs/TjuaeVersionRange" }
      }
    },
    "AssetEntry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "runtimeId",
        "dependencies",
        "displayName",
        "description",
        "version",
        "definitionDigest",
        "entryFile",
        "packageName",
        "author",
        "trust",
        "status",
        "compatibility",
        "sourceRevision",
        "files",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/AssetId" },
        "kind": { "$ref": "#/$defs/AssetKind" },
        "runtimeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AssetId" },
          "description": "该资产直接依赖的稳定远程资产 ID。Core 必须按此字段解析依赖闭包，并通过目标资产的 runtimeId 做运行时映射。"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 4096 },
        "version": { "$ref": "#/$defs/Semver" },
        "definitionDigest": { "$ref": "#/$defs/Integrity" },
        "entryFile": { "$ref": "#/$defs/SafeRelativePath" },
        "packageName": { "$ref": "#/$defs/PackageName" },
        "author": { "type": "string", "minLength": 1, "maxLength": 128 },
        "trust": {
          "type": "string",
          "enum": ["official", "verified", "community"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "revoked"],
          "description": "资产生命周期状态。revoked 由仓库维护者策略强制设置，客户端必须禁止安装和更新。"
        },
        "compatibility": { "$ref": "#/$defs/Compatibility" },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/AssetFile" }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "assistant" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "entryFile": { "const": "assistant.json" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "engineAdapter" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "entryFile": { "const": "engine-adapter.json" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "skill" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "entryFile": { "const": "SKILL.md" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "mcp" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "entryFile": { "const": "mcp.json" } }
          }
        }
      ]
    },
    "PackageEntry": {
      "type": "object",
      "required": [
        "name",
        "version",
        "reviewStatus",
        "atomic",
        "assetIds",
        "dependencies",
        "tarball",
        "integrity",
        "archiveIntegrity",
        "unpackedSize",
        "repository",
        "sourcePath",
        "manifestPath",
        "sourceRevision"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/PackageName" },
        "version": { "$ref": "#/$defs/Semver" },
        "reviewStatus": {
          "type": "string",
          "enum": ["approved", "underReview", "rejected"],
          "description": "包级审核状态。正式 assets 构建只发布 approved。"
        },
        "atomic": { "const": true },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AssetId" }
        },
        "dependencies": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/PackageName" },
          "additionalProperties": { "$ref": "#/$defs/TjuaeVersionRange" }
        },
        "tarball": {
          "type": "string",
          "pattern": "^tjuaeasset-[a-z0-9]+(?:-[a-z0-9]+)*\\.zip$"
        },
        "integrity": { "$ref": "#/$defs/Integrity" },
        "archiveIntegrity": { "$ref": "#/$defs/Integrity" },
        "unpackedSize": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "repository": { "type": "string", "format": "uri" },
        "sourcePath": {
          "type": "string",
          "pattern": "^assets/tjuaeasset-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "manifestPath": {
          "type": "string",
          "pattern": "^assets/tjuaeasset-[a-z0-9]+(?:-[a-z0-9]+)*/asset-package\\.json$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        }
      }
    },
    "IndexMetadata": {
      "type": "object",
      "required": ["totalPackages", "totalAssets", "generatedBy", "repository", "sourceRevision"],
      "additionalProperties": false,
      "properties": {
        "totalPackages": { "type": "integer", "minimum": 1 },
        "totalAssets": { "type": "integer", "minimum": 1 },
        "generatedBy": { "const": "Tjuae 资产构建器 v3.0.0" },
        "repository": { "type": "string", "format": "uri" },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        }
      }
    }
  }
}
