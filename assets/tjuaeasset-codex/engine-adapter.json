{
  "$schema": "https://raw.githubusercontent.com/liangboqiang/TjuaeHub/main/schemas/engine-adapter-definition.v1.schema.json",
  "schemaVersion": 1,
  "kind": "engineAdapter",
  "id": "codex",
  "runtimeId": "codex",
  "displayName": "Codex",
  "description": "通过 ACP 接入 OpenAI Codex 的引擎适配器。",
  "icon": "resources/icon.svg",
  "protocol": {
    "type": "acp",
    "transport": "stdio",
    "arguments": []
  },
  "runtime": {
    "commandName": "codex"
  },
  "capabilities": {
    "streaming": true,
    "authenticationRequired": true,
    "skillsDirectories": [".codex/skills"]
  },
  "configurationSchema": {
    "fields": [
      {
        "key": "apiBaseUrl",
        "label": "API 基础地址",
        "description": "可选的 OpenAI 兼容 API 基础地址。",
        "valueType": "string",
        "required": false,
        "secret": false,
        "binding": {
          "target": "environment",
          "name": "OPENAI_BASE_URL"
        }
      },
      {
        "key": "apiKey",
        "label": "API 密钥",
        "description": "仅在 Core 中加密保存，并在会话启动时注入。",
        "valueType": "string",
        "required": false,
        "secret": true,
        "binding": {
          "target": "environment",
          "name": "OPENAI_API_KEY"
        }
      }
    ]
  }
}
